<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <configSections>
    
    
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="Core.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="Eureka.Stroke.Parser.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration" />
  </configSections>

  <nlog>
    <targets>
      <!-- D:\Projects\med\EurekaStroke\logs -->
       
      <target name="file" type="File" layout="${longdate} ${logger} ${message} ${exception:format=Message,StackTrace}" filename="C:\Projects\Rovbut\logs\EurekaStroke_pendingUploadsRunner${date:format=yyyy-MM-dd}_${level}_log.txt" keepfileopen="false" encoding="iso-8859-2"/>
      <target name="mail" type="Mail" smtpServer="localhost" from="test@example.com" to="test@example.com" subject="Fatal EurekaStroke Error"/>
      <target name="mail_sent" type="File" layout="${longdate} ${logger} ${message} ${exception:format=Message,StackTrace}" filename="C:\Projects\Rovbut\logs\EurekaStroke_mail_sent_pendingUploadsRunner${date:format=yyyy-MM-dd}_${level}_log.txt" keepfileopen="false" encoding="iso-8859-2"/>
    </targets>
    <rules>
      <logger name="Logger" levels="Trace, Debug, Info, Warn, Error, Fatal" writeTo="file"/>
      <logger name="Logger" levels="Fatal" writeTo="mail"/>
      <logger name="mail_sent" levels="Info" writeTo="mail_sent"/>
    </rules>
  </nlog>

  <unity>
    <typeAliases>
      <typeAlias alias="string" type="System.String, mscorlib"/>
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="perThread" type="Microsoft.Practices.Unity.PerThreadLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity"/>
    </typeAliases>
    <containers>
      <container>
        <types>
          <type type="Eureka.Stroke.EurekaStrokeEntities,Core" mapTo="Eureka.Stroke.EurekaStrokeEntities,Core">
            <lifetime type="singleton"/>
            <typeConfig extensionType="Microsoft.Practices.Unity.Configuration.TypeInjectionElement, Microsoft.Practices.Unity.Configuration">
              <constructor/>
            </typeConfig>
          </type>
          <type type="Eureka.Stroke.FormatService.IFormatService,FormatService" mapTo="Eureka.Stroke.FormatService.FormatService,FormatService"/>
          <type type="Eureka.Stroke.UploaderService.IUploaderService,UploaderService" mapTo="Eureka.Stroke.UploaderService.UploaderService,UploaderService"/>
          <type type="Eureka.Stroke.Parser.IParser,Parser" mapTo="Eureka.Stroke.Parser.Parser,Parser"/>
        </types>
        <instances>
          <add name="EurekaFormatName" type="System.String" value="EurekaTest"/>
        </instances>
      </container>
    </containers>
  </unity>


  <connectionStrings>
    <add name="EurekaStrokeEntities" connectionString="metadata=res://*/EurekaStroke.csdl|res://*/EurekaStroke.ssdl|res://*/EurekaStroke.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=.;Initial Catalog=EurekaStroke;Persist Security Info=True;User ID=testuser;Password=testpassword;MultipleActiveResultSets=True&quot;" providerName="System.Data.EntityClient" />
    <add name="EurekaStrokeEntities2" connectionString="metadata=res://*/EurekaStroke.csdl|res://*/EurekaStroke.ssdl|res://*/EurekaStroke.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=.\SQLEXPRESS;Initial Catalog=eureka;Integrated Security=True;&quot;" providerName="System.Data.EntityClient" />

  </connectionStrings>

  <appSettings>
    <!-- D:\Projects\med\EurekaStroke\Upload -->
    <add key="UploaderFolder" value="C:\Projects\Rovbut\Data"></add>
  </appSettings>


  <applicationSettings>
    <Core.Properties.Settings>
      <setting name="EntityConnectionStringName" serializeAs="String">
        <!-- EurekaStrokeEntities -->
        <value>EurekaStrokeEntities</value>
      </setting>
    </Core.Properties.Settings>
    <Eureka.Stroke.Parser.Properties.Settings>
      <setting name="MaxLinesInOnlineMode" serializeAs="String">
        <value>50</value>
      </setting>
      <setting name="LinesInBatch" serializeAs="String">
        <value>1</value>
      </setting>
    </Eureka.Stroke.Parser.Properties.Settings>
    
  </applicationSettings>
  
  
</configuration>