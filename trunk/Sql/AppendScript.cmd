@SETLOCAL
@SET SCRIPT_FILE=%1
@SET RESULT_FILE=%2
@ECHO *** FOUND %SCRIPT_FILE%
@ECHO --%SCRIPT_FILE% >>%RESULT_FILE%
@ECHO PRINT 'Processing file: %SCRIPT_FILE%...' >>%RESULT_FILE% 
@ECHO. >>%RESULT_FILE% 
@ECHO GO >>%RESULT_FILE% 
@ECHO. >>%RESULT_FILE% 
@COPY /A %RESULT_FILE% + %SCRIPT_FILE% %RESULT_FILE%  >NUL
@ECHO. >>%RESULT_FILE% 
@ECHO GO >>%RESULT_FILE% 
@ECHO. >>%RESULT_FILE%
@ENDLOCAL
